f32_to_e4m3_test value = RendererPrimitives.float32_to_e4m3 value

%export "arm-thumb:e4m3_add_test"
e4m3_add_test : E4M3 -> E4M3 -> E4M3
e4m3_add_test left right = RendererPrimitives.e4m3_add left right

%export "arm-thumb:e4m3_sub_test"
e4m3_sub_test : E4M3 -> E4M3 -> E4M3
e4m3_sub_test left right = RendererPrimitives.e4m3_subtract left right

%export "arm-thumb:e4m3_mul_test"
e4m3_mul_test : E4M3 -> E4M3 -> E4M3
e4m3_mul_test left right = RendererPrimitives.e4m3_multiply left right

%export "arm-thumb:e4m3_div_test"
