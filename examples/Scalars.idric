e4m3_div_test left right = RendererPrimitives.e4m3_divide left right

%export "arm-thumb:e5m2_identity"
e5m2_identity : E5M2 -> E5M2
e5m2_identity value = value

%export "arm-thumb:e5m2_to_f32_test"
e5m2_to_f32_test : E5M2 -> Float32
e5m2_to_f32_test value = RendererPrimitives.e5m2_to_float32 value

%export "arm-thumb:f32_to_e5m2_test"
f32_to_e5m2_test : Float32 -> E5M2
f32_to_e5m2_test value = RendererPrimitives.float32_to_e5m2 value

%export "arm-thumb:e5m2_add_test"
e5m2_add_test : E5M2 -> E5M2 -> E5M2
e5m2_add_test left right = RendererPrimitives.e5m2_add left right

%export "arm-thumb:e5m2_sub_test"
e5m2_sub_test : E5M2 -> E5M2 -> E5M2
e5m2_sub_test left right = RendererPrimitives.e5m2_subtract left right

