module Scalars

import RendererPrimitives

%export "arm-thumb:bits8_identity"
bits8_identity : Bits8 -> Bits8
bits8_identity value = value

%export "arm-thumb:bits8_add_test"
bits8_add_test : Bits8 -> Bits8 -> Bits8
bits8_add_test left right = left + right

%export "arm-thumb:bits8_sub_test"
bits8_sub_test : Bits8 -> Bits8 -> Bits8
bits8_sub_test left right = left - right

%export "arm-thumb:bits8_mul_test"
bits8_mul_test : Bits8 -> Bits8 -> Bits8
bits8_mul_test left right = left * right

