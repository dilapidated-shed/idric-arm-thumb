e5m2_div_test left right = RendererPrimitives.e5m2_divide left right

%export "arm-thumb:e3m2_identity"
e3m2_identity : E3M2 -> E3M2
e3m2_identity value = value

%export "arm-thumb:e3m2_to_f32_test"
e3m2_to_f32_test : E3M2 -> Float32
e3m2_to_f32_test value = RendererPrimitives.e3m2_to_float32 value

%export "arm-thumb:f32_to_e3m2_test"
f32_to_e3m2_test : Float32 -> E3M2
f32_to_e3m2_test value = RendererPrimitives.float32_to_e3m2 value

%export "arm-thumb:e3m2_add_test"
e3m2_add_test : E3M2 -> E3M2 -> E3M2
e3m2_add_test left right = RendererPrimitives.e3m2_add left right

%export "arm-thumb:e3m2_sub_test"
e3m2_sub_test : E3M2 -> E3M2 -> E3M2
e3m2_sub_test left right = RendererPrimitives.e3m2_subtract left right

%export "arm-thumb:e3m2_mul_test"
e3m2_mul_test : E3M2 -> E3M2 -> E3M2
e3m2_mul_test left right = RendererPrimitives.e3m2_multiply left right

%export "arm-thumb:e3m2_div_test"
e3m2_div_test : E3M2 -> E3M2 -> E3M2
e3m2_div_test left right = RendererPrimitives.e3m2_divide left right

%export "arm-thumb:e3m2_square_test"
e3m2_square_test : E3M2 -> E3M2
e3m2_square_test value = RendererPrimitives.e3m2_multiply value value

%export "arm-thumb:e3m2_cube_test"
e3m2_cube_test : E3M2 -> E3M2
e3m2_cube_test value =
  let square = RendererPrimitives.e3m2_multiply value value
  in RendererPrimitives.e3m2_multiply square value

%export "arm-thumb:e3m2_sqrt_test"
e3m2_sqrt_test : E3M2 -> E3M2
e3m2_sqrt_test value =
  let wide = RendererPrimitives.e3m2_to_float32 value
      rooted = RendererPrimitives.float32_square_root wide
  in RendererPrimitives.float32_to_e3m2 rooted

%export "arm-thumb:e3m2_dot2_test"
e3m2_dot2_test : E3M2 -> E3M2 -> E3M2 -> E3M2 -> E3M2
e3m2_dot2_test a b x y =
  let ax = RendererPrimitives.e3m2_multiply a x
      by = RendererPrimitives.e3m2_multiply b y
  in RendererPrimitives.e3m2_add ax by

%export "arm-thumb:e3m2_rotate_x_test"
e3m2_rotate_x_test : E3M2 -> E3M2 -> E3M2 -> E3M2 -> E3M2
e3m2_rotate_x_test cosine sine x y =
  let cx = RendererPrimitives.e3m2_multiply cosine x
      sy = RendererPrimitives.e3m2_multiply sine y
  in RendererPrimitives.e3m2_subtract cx sy

%export "arm-thumb:e3m2_rotate_y_test"
e3m2_rotate_y_test : E3M2 -> E3M2 -> E3M2 -> E3M2 -> E3M2
e3m2_rotate_y_test sine cosine x y =
  let sx = RendererPrimitives.e3m2_multiply sine x
      cy = RendererPrimitives.e3m2_multiply cosine y
  in RendererPrimitives.e3m2_add sx cy

%export "arm-thumb:e5m3_identity"
e5m3_identity : E5M3 -> E5M3
e5m3_identity value = value

%export "arm-thumb:e5m3_to_f32_test"
e5m3_to_f32_test : E5M3 -> Float32
e5m3_to_f32_test value = RendererPrimitives.e5m3_to_float32 value

%export "arm-thumb:f32_to_e5m3_test"
f32_to_e5m3_test : Float32 -> E5M3
f32_to_e5m3_test value = RendererPrimitives.float32_to_e5m3 value


%export "arm-thumb:float16_source_add_test"
float16_source_add_test : Float16 -> Float16 -> Float16
float16_source_add_test left right = left + right

%export "arm-thumb:e4m3_source_add_test"
e4m3_source_add_test : E4M3 -> E4M3 -> E4M3
e4m3_source_add_test left right = left + right

%export "arm-thumb:e5m2_source_add_test"
e5m2_source_add_test : E5M2 -> E5M2 -> E5M2
e5m2_source_add_test left right = left + right

%export "arm-thumb:e3m2_source_add_test"
e3m2_source_add_test : E3M2 -> E3M2 -> E3M2
e3m2_source_add_test left right = left + right

main : IO ()
main = pure ()
