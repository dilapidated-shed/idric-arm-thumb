module Scalars

import RendererPrimitives

%export "arm-thumb:bits8_identity"
bits8_identity : Bits8 -> Bits8
bits8_identity value = value

%export "arm-thumb:bits8_add_test"
bits8_add_test : Bits8 -> Bits8 -> Bits8
bits8_add_test left right = left + right

%export "arm-thumb:bits8_sub_test"
bits8_sub_test : Bits8 -> Bits8 -> Bits8
bits8_sub_test left right = left - right

%export "arm-thumb:bits8_mul_test"
bits8_mul_test : Bits8 -> Bits8 -> Bits8
bits8_mul_test left right = left * right

%export "arm-thumb:float16_identity"
float16_identity : Float16 -> Float16
float16_identity value = value

%export "arm-thumb:float16_to_f32_test"
float16_to_f32_test : Float16 -> Float32
float16_to_f32_test value = RendererPrimitives.float16_to_float32 value

%export "arm-thumb:f32_to_float16_test"
f32_to_float16_test : Float32 -> Float16
f32_to_float16_test value = RendererPrimitives.float32_to_float16 value

%export "arm-thumb:float16_add_test"
float16_add_test : Float16 -> Float16 -> Float16
float16_add_test left right = RendererPrimitives.float16_add left right

%export "arm-thumb:float16_sub_test"
float16_sub_test : Float16 -> Float16 -> Float16
float16_sub_test left right = RendererPrimitives.float16_subtract left right

%export "arm-thumb:float16_mul_test"
float16_mul_test : Float16 -> Float16 -> Float16
float16_mul_test left right = RendererPrimitives.float16_multiply left right

%export "arm-thumb:float16_div_test"
float16_div_test : Float16 -> Float16 -> Float16
float16_div_test left right = RendererPrimitives.float16_divide left right

